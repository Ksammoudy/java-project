<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>org.example</groupId>
    <artifactId>WasteWiseTn</artifactId>
    <version>1.0-SNAPSHOT</version>
    <name>WasteWiseTn</name>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>21</maven.compiler.release>
        <javafx.version>21.0.2</javafx.version>
        <maven.compiler.plugin.version>3.13.0</maven.compiler.plugin.version>
        <javafx.maven.plugin.version>0.0.8</javafx.maven.plugin.version>
    </properties>

    <dependencies>

        <!-- ============================================================ -->
        <!-- JAVA FX DEPENDENCIES - For building the desktop application -->
        <!-- ============================================================ -->

        <!-- JavaFX Controls: Provides UI components like buttons, tables, labels, text fields -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- JavaFX FXML: Loads UI layouts from FXML files (XML-based interface design) -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- JavaFX Web: Embeds web browser component to display maps and web content -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-web</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- ============================================================ -->
        <!-- DATABASE DEPENDENCY - For MySQL connection -->
        <!-- ============================================================ -->

        <!-- MySQL Connector: Allows Java to connect and interact with MySQL database -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>9.3.0</version>
        </dependency>

        <!-- ============================================================ -->
        <!-- SECURITY DEPENDENCY - For password encryption -->
        <!-- ============================================================ -->

        <!-- BCrypt: Hashes and verifies user passwords securely (not plain text storage) -->
        <dependency>
            <groupId>org.mindrot</groupId>
            <artifactId>jbcrypt</artifactId>
            <version>0.4</version>
        </dependency>

        <!-- ============================================================ -->
        <!-- EMAIL DEPENDENCIES - For sending email notifications -->
        <!-- ============================================================ -->

        <!-- Jakarta Mail: Sends emails (alerts for critical pollution zones) -->
        <dependency>
            <groupId>com.sun.mail</groupId>
            <artifactId>jakarta.mail</artifactId>
            <version>2.0.1</version>
        </dependency>

        <!-- Jakarta Activation: Required for Jakarta Mail to handle email attachments -->
        <dependency>
            <groupId>com.sun.activation</groupId>
            <artifactId>jakarta.activation</artifactId>
            <version>2.0.1</version>
        </dependency>

        <!-- ============================================================ -->
        <!-- WEB FRAMEWORK - For REST API endpoints -->
        <!-- ============================================================ -->

        <!-- Spark Java: Lightweight web framework to create REST APIs for external access -->
        <dependency>
            <groupId>com.sparkjava</groupId>
            <artifactId>spark-core</artifactId>
            <version>2.9.4</version>
        </dependency>

        <!-- ============================================================ -->
        <!-- JSON PARSING - For API communication -->
        <!-- ============================================================ -->

        <!-- Gson: Converts Java objects to JSON and vice versa (used for Gemini API calls) -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.10.1</version>
        </dependency>

        <!-- ============================================================ -->
        <!-- PDF GENERATION - For exporting reports -->
        <!-- ============================================================ -->

        <!-- iText7 Core: Main PDF library for generating professional reports and zone summaries -->
        <dependency>
            <groupId>com.itextpdf</groupId>
            <artifactId>itext7-core</artifactId>
            <version>7.2.5</version>
            <type>pom</type>
        </dependency>

        <!-- iText7 Layout: Handles document layout, tables, and positioning in PDFs -->
        <dependency>
            <groupId>com.itextpdf</groupId>
            <artifactId>layout</artifactId>
            <version>7.2.5</version>
        </dependency>

        <!-- iText7 Kernel: Core PDF engine for reading/writing PDF documents -->
        <dependency>
            <groupId>com.itextpdf</groupId>
            <artifactId>kernel</artifactId>
            <version>7.2.5</version>
        </dependency>

        <!-- iText7 Font Asian: Adds support for Arabic, Chinese, Japanese fonts in PDFs -->
        <dependency>
            <groupId>com.itextpdf</groupId>
            <artifactId>font-asian</artifactId>
            <version>7.2.5</version>
        </dependency>

        <!-- ============================================================ -->
        <!-- HTTP CLIENT - For making external API calls -->
        <!-- ============================================================ -->

        <!-- OkHttp: Modern HTTP client for calling external APIs (Geocoding, Gemini, QR APIs) -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp</artifactId>
            <version>4.12.0</version>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!-- ============================================================ -->
            <!-- MAVEN COMPILER PLUGIN - Compiles Java code with Java 21 -->
            <!-- ============================================================ -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven.compiler.plugin.version}</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                </configuration>
            </plugin>

            <!-- ============================================================ -->
            <!-- JAVA FX MAVEN PLUGIN - Runs and packages JavaFX application -->
            <!-- ============================================================ -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>${javafx.maven.plugin.version}</version>
                <configuration>
                    <mainClass>org.example.Main</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>