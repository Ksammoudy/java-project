<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="30.0" prefHeight="600.0" prefWidth="450.0"
      style="-fx-background-color: #F8F9FA;" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controllers.gestionevent.RoleSelectionController">

    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
    </padding>

    <Label text="Select Your Role" style="-fx-font-weight: bold; -fx-font-size: 28px; -fx-text-fill: #1A1A1A;" />

    <VBox spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-border-color: #E0E0E0; -fx-border-radius: 15; -fx-padding: 20;">
        <Label text="Citoyen" style="-fx-font-weight: bold; -fx-font-size: 18px;" />
        <Label text="Consulter et participer aux événements éco" style="-fx-text-fill: #808080;" />
        <Button fx:id="btnCitoyen" onAction="#handleCitoyen" maxWidth="Infinity" prefHeight="45.0"
                text="Continue as Citoyen"
                style="-fx-background-color: #5D5FEF; -fx-text-fill: white; -fx-background-radius: 10; -fx-font-weight: bold;" />
    </VBox>

    <VBox spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-border-color: #E0E0E0; -fx-border-radius: 15; -fx-padding: 20;">
        <Label text="Organisateur" style="-fx-font-weight: bold; -fx-font-size: 18px;" />
        <Label text="Organiser et gérer vos propres événements" style="-fx-text-fill: #808080;" />
        <Button fx:id="btnOrganisateur" onAction="#handleOrganisateur" maxWidth="Infinity" prefHeight="45.0"
                text="Continue as Organisateur"
                style="-fx-background-color: #F2994A; -fx-text-fill: white; -fx-background-radius: 10; -fx-font-weight: bold;" />
    </VBox>
</VBox>