<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.web.WebView?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="450.0" prefWidth="320.0" style="-fx-background-color: white; -fx-background-radius: 20; -fx-border-radius: 20; -fx-border-color: #f1f2f6; -fx-border-width: 1;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controllers.gestionevent.EventCardController">
    <children>
        <VBox spacing="0.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <WebView fx:id="mapView" minHeight="200.0" prefHeight="220.0" prefWidth="318.0" />

                <VBox spacing="8.0" style="-fx-padding: 15;">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <children>
                                <Label fx:id="organizerName" style="-fx-background-color: #e9f7ef; -fx-background-radius: 15; -fx-padding: 5 12; -fx-text-fill: #27ae60;" text="👤 Nom" />

                                <HBox alignment="CENTER_RIGHT" spacing="8" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label fx:id="weatherLabel" text="☀️ --°C" textFill="#f39c12" style="-fx-font-weight: bold;">
                                            <font><Font size="12.0" /></font>
                                        </Label>
                                        <Label fx:id="distanceLabel" text="🚗 -- km" textFill="#3498db" style="-fx-font-weight: bold;">
                                            <font><Font size="12.0" /></font>
                                        </Label>
                                    </children>
                                </HBox>
                            </children>
                        </HBox>

                        <Label fx:id="eventTitle" text="Chargement..." textFill="#2d3436" wrapText="true">
                            <font><Font name="System Bold" size="20.0" /></font>
                        </Label>

                        <Label fx:id="eventLocation" text="📍 Adresse" textFill="#636e72" wrapText="true">
                            <font><Font size="13.0" /></font>
                        </Label>

                        <VBox alignment="BOTTOM_CENTER" VBox.vgrow="ALWAYS" style="-fx-padding: 10 0 0 0;">
                            <children>
                                <Button fx:id="participerBtn" onAction="#handleParticiper" maxWidth="1.7976931348623157E308" mnemonicParsing="false" style="-fx-background-color: #1b8a5a; -fx-text-fill: white; -fx-background-radius: 25; -fx-padding: 12; -fx-cursor: hand;" text="Participer">
                                    <font>
                                        <Font name="System Bold" size="14.0" />
                                    </font>
                                </Button>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</AnchorPane>