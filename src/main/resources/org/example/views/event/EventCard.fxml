<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.web.WebView?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="450.0" prefWidth="320.0" style="-fx-background-color: white; -fx-background-radius: 20; -fx-border-radius: 20; -fx-border-color: #f1f2f6; -fx-border-width: 1; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controllers.gestionevent.EventCardController">
    <children>
        <VBox spacing="0.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <!-- WebView b-taille fixe bech Leaflet ma d-id-khallat-ch -->
                <WebView fx:id="mapView" minHeight="220.0" prefHeight="220.0" prefWidth="320.0" />

                <VBox spacing="10.0" style="-fx-padding: 15;">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <children>
                                <Label fx:id="organizerName" style="-fx-background-color: #e9f7ef; -fx-background-radius: 15; -fx-padding: 5 12; -fx-text-fill: #27ae60; -fx-font-weight: bold;" text="👤 Nom" />
                                <HBox alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label fx:id="distanceLabel" style="-fx-font-weight: bold;" text="🚗 -- km" textFill="#3498db">
                                            <font><Font size="12.0" /></font>
                                        </Label>
                                    </children>
                                </HBox>
                            </children>
                        </HBox>

                        <Label fx:id="eventTitle" text="Chargement..." textFill="#2d3436" wrapText="true">
                            <font><Font name="System Bold" size="22.0" /></font>
                        </Label>

                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <children>
                                <Label fx:id="eventLocation" text="📍 Adresse" textFill="#636e72" wrapText="true">
                                    <font><Font size="14.0" /></font>
                                </Label>
                                <Label fx:id="weatherLabel" text="☀️ --°C" textFill="#f39c12" style="-fx-font-weight: bold;">
                                    <font><Font size="12.0" /></font>
                                </Label>
                            </children>
                        </HBox>

                        <VBox alignment="BOTTOM_CENTER" VBox.vgrow="ALWAYS" style="-fx-padding: 15 0 0 0;">
                            <children>
                                <Button fx:id="participerBtn" maxWidth="1.7976931348623157E308" onAction="#handleParticiper" style="-fx-background-color: #1b8a5a; -fx-text-fill: white; -fx-background-radius: 25; -fx-padding: 12; -fx-cursor: hand;" text="Participer">
                                    <font><Font name="System Bold" size="15.0" /></font>
                                </Button>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</AnchorPane>