<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import java.net.URL?>

<!-- El VBox el kbir mte3ek -->
<VBox spacing="20.0" style="-fx-background-color: #f4f4f4; -fx-padding: 20;"
      xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controllers.gestionevent.DashboardController"
      stylesheets="@dashboard.css">

    <!-- 1. Header Banner -->
    <VBox prefHeight="120.0" style="-fx-background-color: linear-gradient(to right, #2D5224, #4CAF50); -fx-background-radius: 15; -fx-padding: 20;">
        <children>
            <Label text="Bienvenue sur WasteWiseTN" textFill="WHITE">
                <font><Font name="System Bold" size="28.0" /></font>
            </Label>
            <Label text="Consultez les statistiques de votre projet en temps réel." textFill="WHITE" />
        </children>
    </VBox>

    <!-- 2. Cards Section -->
    <HBox spacing="30.0">
        <children>
            <VBox prefHeight="100.0" prefWidth="300.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">
                <children>
                    <Label text="ÉVÉNEMENTS TOTAUX" textFill="#777" />
                    <Label fx:id="totalEventsLabel" text="0" textFill="#2D5224">
                        <font><Font name="System Bold" size="36.0" /></font>
                    </Label>
                </children>
            </VBox>
            <VBox prefHeight="100.0" prefWidth="300.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">
                <children>
                    <Label text="PARTICIPATIONS TOTALES" textFill="#777" />
                    <Label fx:id="totalParticipationsLabel" text="0" textFill="#2196F3">
                        <font><Font name="System Bold" size="36.0" /></font>
                    </Label>
                </children>
            </VBox>
        </children>
    </HBox>

    <!-- 3. Table Section -->
    <VBox VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">
        <children>
            <Label text="📊 Suivi des Inscriptions" textFill="#2D5224" style="-fx-padding: 0 0 10 0;">
                <font><Font name="System Bold" size="18.0" /></font>
            </Label>
            <TableView fx:id="statsTable" prefHeight="300.0" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colNomEvent" prefWidth="250.0" text="Nom de l'Événement" />
                    <TableColumn fx:id="colOrganisateur" prefWidth="200.0" text="Organisateur" />
                    <TableColumn fx:id="colNbParticipants" prefWidth="150.0" text="Participants" />
                </columns>
            </TableView>
        </children>
    </VBox>

</VBox> <!-- Houni el VBox el kbir ysakker -->