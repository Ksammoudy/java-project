<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.shape.Rectangle?>

<AnchorPane prefHeight="600.0" prefWidth="400.0" style="-fx-background-color: #f8f9fa;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controllers.gestionevent.AjouterParticipationControllerFront">
    <children>
        <Rectangle fill="#1b8a5a" height="120.0" stroke="TRANSPARENT" width="400.0" />
        <VBox alignment="CENTER" layoutY="30.0" prefWidth="400.0" spacing="5">
            <children>
                <Label text="Participer à l'événement" textFill="WHITE">
                    <font><Font name="System Bold" size="24.0" /></font>
                </Label>
            </children>
        </VBox>

        <VBox layoutX="30.0" layoutY="140.0" prefWidth="340.0" spacing="20.0" style="-fx-background-color: white; -fx-padding: 30; -fx-background-radius: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">
            <children>
                <VBox spacing="8.0">
                    <children>
                        <Label text="Nom complet" /><TextField fx:id="nomInput" prefHeight="40.0" style="-fx-background-radius: 10;" />
                    </children>
                </VBox>
                <VBox spacing="8.0">
                    <children>
                        <Label text="Email" /><TextField fx:id="emailInput" prefHeight="40.0" style="-fx-background-radius: 10;" />
                    </children>
                </VBox>
                <Button onAction="#handleValiderParticipation" maxWidth="Infinity" prefHeight="45.0" style="-fx-background-color: #1b8a5a; -fx-text-fill: white; -fx-background-radius: 10;" text="Confirmer" />
                <Button onAction="#handleRetour" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: #636e72;" text="Retour" />
            </children>
        </VBox>
    </children>
</AnchorPane>