<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import java.lang.String?>
<?import javafx.collections.FXCollections?>

<VBox spacing="20" styleClass="main-content"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controllers.gestionevent.ParticipationsController"
      stylesheets="@participation.css">

    <VBox styleClass="header-banner">
        <Label text="Gestion des Participations" styleClass="header-title" />
        <Label text="Suivez les inscriptions des citoyens aux différents événements écologiques." styleClass="header-subtitle" />
    </VBox>

    <HBox alignment="CENTER_LEFT" spacing="20" styleClass="list-header-container">
        <Label text="👥 Liste des Participants" styleClass="list-title" />
        <Region HBox.hgrow="ALWAYS" />

        <HBox spacing="10" alignment="CENTER">
            <!-- Recherche Field -->
            <TextField fx:id="searchField" promptText="🔍 Rechercher un citoyen..."
                       styleClass="search-container" prefWidth="250.0" />

            <!-- ComboBox Tri -->
            <ComboBox fx:id="sortComboBox" promptText="Sort By" prefWidth="150.0" styleClass="search-container">
                <items>
                    <FXCollections fx:factory="observableArrayList">
                        <String fx:value="Nom (A-Z)" />
                        <String fx:value="Nom (Z-A)" />
                    </FXCollections>
                </items>
            </ComboBox>

            <Button onAction="#handleAjouterParticipant" styleClass="nav-button-active" text="+ Inscrire" />
        </HBox>
    </HBox>

    <TableView fx:id="participationTable" VBox.vgrow="ALWAYS" styleClass="table-view">
        <columns>
            <TableColumn fx:id="colCitoyen" prefWidth="200.0" text="Nom du Citoyen" />
            <TableColumn fx:id="colEvenement" prefWidth="250.0" text="Événement" />
            <TableColumn fx:id="colDate" prefWidth="150.0" text="Date d'Inscription" />
            <TableColumn fx:id="colActions" prefWidth="150.0" text="Actions" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>
</VBox>