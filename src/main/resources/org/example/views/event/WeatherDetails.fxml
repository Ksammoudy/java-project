<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 20; -fx-border-color: #74c365; -fx-border-radius: 20; -fx-border-width: 2;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controllers.gestionevent.WeatherDetailsController">
    <children>
        <Label text="Prévisions Météo Détails" textFill="#2d6a4f">
            <font>
                <Font name="System Bold" size="22.0" />
            </font>
        </Label>

        <VBox alignment="CENTER" spacing="10.0" style="-fx-background-color: #f1f8e9; -fx-background-radius: 15; -fx-padding: 20;">
            <children>
                <Label fx:id="lblCity" text="Ariana, Tunisie" textFill="#2d6a4f">
                    <font> <Font size="18.0" /> </font>
                </Label>
                <Label fx:id="lblTemp" text="19°C" textFill="#1b4332">
                    <font> <Font name="System Bold" size="40.0" /> </font>
                </Label>
                <Label fx:id="lblDescription" text="Peu Nuageux" textFill="#40916c" />
            </children>
        </VBox>

        <GridPane hgap="20.0" vgap="10.0">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            </rowConstraints>
            <children>
                <VBox alignment="CENTER">
                    <children>
                        <Label text="Humidité" textFill="#6c757d" />
                        <Label fx:id="lblHumidity" text="88%" style="-fx-font-weight: bold;" />
                    </children>
                </VBox>
                <VBox alignment="CENTER" GridPane.columnIndex="1">
                    <children>
                        <Label text="Vent" textFill="#6c757d" />
                        <Label fx:id="lblWind" text="4.12 km/h" style="-fx-font-weight: bold;" />
                    </children>
                </VBox>
                <VBox alignment="CENTER" GridPane.rowIndex="1">
                    <children>
                        <Label text="Pression" textFill="#6c757d" />
                        <Label fx:id="lblPressure" text="1014 hPa" style="-fx-font-weight: bold;" />
                    </children>
                </VBox>
                <VBox alignment="CENTER" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <children>
                        <Label text="Ressenti" textFill="#6c757d" />
                        <Label fx:id="lblFeelsLike" text="19°C" style="-fx-font-weight: bold;" />
                    </children>
                </VBox>
            </children>
        </GridPane>

        <Button fx:id="btnRetour" onAction="#handleRetour" style="-fx-background-color: #74c365; -fx-text-fill: white; -fx-background-radius: 10;" text="← Retour aux événements" prefWidth="200.0" prefHeight="35.0" />
    </children>
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>
</VBox>