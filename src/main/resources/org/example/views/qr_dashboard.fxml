<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controllers.QRDashboardController"
      styleClass="workspace-main"
      stylesheets="/org/example/styles/style.css">

    <VBox styleClass="main-content" spacing="20" style="-fx-padding: 20;" VBox.vgrow="ALWAYS">

        <VBox styleClass="hero" spacing="10" style="-fx-background-color: linear-gradient(to right, #2f6b4f, #8bd22f); -fx-background-radius: 20; -fx-padding: 40;">
            <Label text="📱 Historique des scans QR" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label text="Consultez tous les citoyens qui ont scanné les zones polluées" style="-fx-text-fill: rgba(255,255,255,0.85);"/>
        </VBox>

        <HBox spacing="20">
            <VBox styleClass="stat-card" spacing="10" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 18; -fx-padding: 20;">
                <Text text="📱" style="-fx-font-size: 24px;"/>
                <Text fx:id="totalScansText" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-fill: #1a3a2a;">0</Text>
                <Text text="Total scans" style="-fx-fill: #6c757d; -fx-font-size: 12px;"/>
            </VBox>
            <VBox styleClass="stat-card" spacing="10" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 18; -fx-padding: 20;">
                <Text text="📍" style="-fx-font-size: 24px;"/>
                <Text fx:id="uniqueZonesText" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-fill: #1a3a2a;">0</Text>
                <Text text="Zones scannées" style="-fx-fill: #6c757d; -fx-font-size: 12px;"/>
            </VBox>
            <VBox styleClass="stat-card" spacing="10" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 18; -fx-padding: 20;">
                <Text text="📊" style="-fx-font-size: 24px;"/>
                <Text fx:id="avgPerZoneText" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-fill: #1a3a2a;">0,0</Text>
                <Text text="Moyenne par zone" style="-fx-fill: #6c757d; -fx-font-size: 12px;"/>
            </VBox>
        </HBox>

        <VBox styleClass="big-card" spacing="15" style="-fx-background-color: white; -fx-background-radius: 18; -fx-padding: 20;" VBox.vgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT">
                <Text text="📋 Liste des scans" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="🔄 Rafraîchir" styleClass="primary-btn" onAction="#refreshScans"/>
            </HBox>
            <TableView fx:id="scanTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
                    <TableColumn fx:id="colZoneName" text="Zone" prefWidth="200"/>
                    <TableColumn fx:id="colDate" text="Date scan" prefWidth="160"/>
                    <TableColumn fx:id="colIp" text="IP" prefWidth="130"/>
                    <TableColumn fx:id="colCountry" text="Pays" prefWidth="120"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
    </VBox>
</VBox>


