<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controllers.QRDashboardController"
            stylesheets="@../styles/style.css">

    <!-- SIDEBAR -->
    <left>
        <VBox styleClass="sidebar" prefWidth="280" style="-fx-background-color: #1a3a2a;">
            <VBox styleClass="sidebar-header" spacing="10" alignment="CENTER" style="-fx-padding: 30 0 30 0;">
                <Text text="🌱 WasteWise" style="-fx-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>
            </VBox>

            <VBox styleClass="sidebar-menu" spacing="5" style="-fx-padding: 20 15 0 15;">
                <Text style="-fx-fill: rgba(255,255,255,0.4); -fx-font-size: 11px; -fx-font-weight: bold;">MAIN</Text>
                <Button text="📊 Dashboard" styleClass="sidebar-btn" onAction="#goToDashboard"/>
                <Button text="📍 Zones Polluées" styleClass="sidebar-btn" onAction="#goToZones"/>
                <Button text="📈 Indicateurs" styleClass="sidebar-btn" onAction="#goToIndicateurs"/>
                <Button text="📱 Scans QR" styleClass="sidebar-btn active"/>
            </VBox>
        </VBox>
    </left>

    <!-- MAIN CONTENT -->
    <center>
        <VBox styleClass="main-content" spacing="20" style="-fx-padding: 20;">

            <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 0 0 10 0;">
                <Label text="Dashboard / Scans QR" style="-fx-font-size: 14px; -fx-text-fill: #6c757d;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="🔔" style="-fx-background-color: transparent;"/>
                <Button text="👤 Admin" style="-fx-background-color: transparent; -fx-font-weight: bold;"/>
            </HBox>

            <VBox styleClass="hero" spacing="10" style="-fx-background-color: linear-gradient(to right, #2f6b4f, #8bd22f); -fx-background-radius: 20; -fx-padding: 40;">
                <Label text="📱 Historique des scans QR" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <Label text="Consultez tous les citoyens qui ont scanné les zones polluées" style="-fx-text-fill: rgba(255,255,255,0.85);"/>
            </VBox>

            <!-- Stats Cards -->
            <HBox spacing="20">
                <VBox styleClass="stat-card" spacing="10" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 18; -fx-padding: 20;">
                    <Text text="📱" style="-fx-font-size: 24px;"/>
                    <Text fx:id="totalScansText" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-fill: #1a3a2a;">0</Text>
                    <Text text="Total scans" style="-fx-fill: #6c757d; -fx-font-size: 12px;"/>
                </VBox>
                <VBox styleClass="stat-card" spacing="10" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 18; -fx-padding: 20;">
                    <Text text="📍" style="-fx-font-size: 24px;"/>
                    <Text fx:id="uniqueZonesText" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-fill: #1a3a2a;">0</Text>
                    <Text text="Zones scannées" style="-fx-fill: #6c757d; -fx-font-size: 12px;"/>
                </VBox>
                <VBox styleClass="stat-card" spacing="10" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 18; -fx-padding: 20;">
                    <Text text="📊" style="-fx-font-size: 24px;"/>
                    <Text fx:id="avgPerZoneText" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-fill: #1a3a2a;">0</Text>
                    <Text text="Moyenne par zone" style="-fx-fill: #6c757d; -fx-font-size: 12px;"/>
                </VBox>
            </HBox>

            <!-- Tableau des scans -->
            <VBox styleClass="big-card" spacing="15" style="-fx-background-color: white; -fx-background-radius: 18; -fx-padding: 20;">
                <HBox alignment="CENTER_LEFT">
                    <Text text="📋 Liste des scans" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="🔄 Rafraîchir" styleClass="btn-green" onAction="#refreshScans"/>
                </HBox>

                <TableView fx:id="scanTable" prefHeight="400">
                    <columns>
                        <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
                        <TableColumn fx:id="colZoneName" text="Zone" prefWidth="180"/>
                        <TableColumn fx:id="colDate" text="Date scan" prefWidth="150"/>
                        <TableColumn fx:id="colIp" text="IP" prefWidth="120"/>
                        <TableColumn fx:id="colCountry" text="Pays" prefWidth="100"/>
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </center>
</BorderPane>