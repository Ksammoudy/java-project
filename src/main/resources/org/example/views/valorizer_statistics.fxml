<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controllers.ValorizerStatisticsController"
            styleClass="workspace-root">
    <left>
        <VBox prefWidth="276.0" spacing="10.0" styleClass="workspace-sidebar">
            <padding>
                <Insets top="24.0" right="16.0" bottom="16.0" left="16.0"/>
            </padding>
            <VBox spacing="4.0" styleClass="brand-shell">
                <Label text="WasteWise" styleClass="brand-logo-text"/>
            </VBox>
            <Label text="Menu Principal" styleClass="sidebar-section"/>
            <Button fx:id="navHome" text="Accueil" onAction="#handleDashboard" maxWidth="Infinity" styleClass="sidebar-nav muted"/>
            <Button fx:id="navWasteReceived" text="Dechets recus" onAction="#handleWasteReceived" maxWidth="Infinity" styleClass="sidebar-nav muted"/>
            <Button fx:id="navValorization" text="Valorisation" onAction="#handleValorization" maxWidth="Infinity" styleClass="sidebar-nav muted"/>
            <Button fx:id="navStatistics" text="Statistiques" onAction="#handleStatistics" maxWidth="Infinity" styleClass="sidebar-nav active"/>
            <Button fx:id="navSettings" text="Parametres" onAction="#handleSettings" maxWidth="Infinity" styleClass="sidebar-nav muted"/>
            <Region VBox.vgrow="ALWAYS"/>
            <VBox spacing="2.0" styleClass="sidebar-footer">
                <Label fx:id="valorizerNameLabel" text="Utilisateur Demo" styleClass="user-meta-name"/>
                <Label text="Valorisateur" styleClass="user-meta-role"/>
            </VBox>
        </VBox>
    </left>
    <center>
        <VBox styleClass="workspace-main">
            <HBox spacing="12.0" alignment="CENTER_LEFT" styleClass="workspace-topbar">
                <Button text="Menu" styleClass="crumb-button"/>
                <Label text="Valorisateur &gt;" styleClass="crumb-text"/>
                <Label text="Analyse" styleClass="crumb-text"/>
                <Label text="Statistiques" styleClass="crumb-current"/>
                <Region HBox.hgrow="ALWAYS"/>
                <VBox alignment="CENTER_RIGHT" spacing="3.0">
                    <Label fx:id="headerEmailLabel" text="—" styleClass="workspace-title"/>
                    <Label text="Valorisateur" styleClass="workspace-subtitle-strong"/>
                </VBox>
            </HBox>
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="content-scroll">
                <content>
                    <VBox spacing="18.0" styleClass="workspace-content">
                        <VBox spacing="10.0" styleClass="hero-panel">
                            <Label text="Statistiques Valorisateur" styleClass="hero-title"/>
                            <Label text="Analyse des performances et metriques de valorisation." styleClass="hero-subtitle"/>
                        </VBox>

                        <HBox spacing="18.0">
                            <VBox HBox.hgrow="ALWAYS" spacing="10.0" styleClass="stat-card">
                                <Label text="Total recu" styleClass="stat-title"/>
                                <Label fx:id="totalReceivedLabel" text="—" styleClass="stat-value-large"/>
                            </VBox>
                            <VBox HBox.hgrow="ALWAYS" spacing="10.0" styleClass="stat-card">
                                <Label text="Total valorise" styleClass="stat-title"/>
                                <Label fx:id="totalValorizedLabel" text="—" styleClass="stat-value-large"/>
                            </VBox>
                            <VBox HBox.hgrow="ALWAYS" spacing="10.0" styleClass="stat-card">
                                <Label text="Total points" styleClass="stat-title"/>
                                <Label fx:id="totalPointsLabel" text="—" styleClass="stat-value-large"/>
                            </VBox>
                            <VBox HBox.hgrow="ALWAYS" spacing="10.0" styleClass="stat-card">
                                <Label text="En attente" styleClass="stat-title"/>
                                <Label fx:id="pendingLabel" text="—" styleClass="stat-value-large"/>
                            </VBox>
                        </HBox>

                        <HBox spacing="18.0">
                            <VBox HBox.hgrow="ALWAYS" spacing="14.0" styleClass="panel-card">
                                <Label text="Tendances mensuelles" styleClass="panel-heading"/>
                                <BarChart fx:id="estadisticsChart" legendVisible="false" prefHeight="280.0">
                                    <xAxis>
                                        <CategoryAxis/>
                                    </xAxis>
                                    <yAxis>
                                        <NumberAxis/>
                                    </yAxis>
                                </BarChart>
                            </VBox>
                        </HBox>
                    </VBox>
                </content>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>
