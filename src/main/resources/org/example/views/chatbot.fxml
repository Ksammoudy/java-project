<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controllers.ChatbotController">

    <top>
        <VBox style="-fx-background-color: linear-gradient(to right, #2e7d32, #4caf50);">
            <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 15 20 15 20;">
                <Label text="🤖" style="-fx-font-size: 24px;"/>
                <VBox>
                    <Label text="WasteWise Assistant IA" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px;"/>
                    <Label fx:id="chatbotStatus" text="Initialisation..." style="-fx-text-fill: rgba(255,255,255,0.8); -fx-font-size: 11px;"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="−" onAction="#minimizeChatbot" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-cursor: hand;"/>
                <Button text="✕" fx:id="closeButton" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <StackPane>
            <ScrollPane fx:id="chatScrollPane" fitToWidth="true" style="-fx-background-color: #fafafa; -fx-background: #fafafa;">
                <VBox fx:id="chatArea" spacing="5" style="-fx-padding: 20;">
                    <VBox alignment="CENTER" spacing="10" style="-fx-padding: 20 0;">
                        <Label text="🤖" style="-fx-font-size: 48px;"/>
                        <Label text="WasteWise Assistant IA" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2e7d32;"/>
                        <Label text="Propulsé par Google Gemini AI" style="-fx-text-fill: #666; -fx-font-size: 12px;"/>
                    </VBox>
                </VBox>
            </ScrollPane>
            <ProgressIndicator fx:id="loadingIndicator" visible="false"
                               style="-fx-progress-color: #4caf50;"
                               maxWidth="40" maxHeight="40"/>
        </StackPane>
    </center>

    <bottom>
        <VBox style="-fx-background-color: white; -fx-border-color: #e0e0e0; -fx-border-width: 1 0 0 0;">
            <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 15 20 15 20;">
                <TextField fx:id="messageInput" promptText="Posez votre question sur les zones polluées..."
                           HBox.hgrow="ALWAYS"
                           style="-fx-background-radius: 25; -fx-border-radius: 25; -fx-padding: 10 15 10 15; -fx-background-color: #f5f5f5; -fx-border-color: #e0e0e0;"/>
                <Button fx:id="sendButton" text="📤"
                        style="-fx-background-color: #4caf50; -fx-text-fill: white; -fx-font-size: 16px; -fx-background-radius: 25; -fx-min-width: 40; -fx-min-height: 40; -fx-cursor: hand;"/>
            </HBox>
            <Label text="💡 L'IA comprend le langage naturel! Posez n'importe quelle question sur les zones polluées."
                   style="-fx-text-fill: #999; -fx-font-size: 10px; -fx-padding: 0 20 15 20;"/>
        </VBox>
    </bottom>

</BorderPane>