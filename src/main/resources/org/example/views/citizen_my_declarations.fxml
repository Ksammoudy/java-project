<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controllers.CitizenMyDeclarationsController"
            styleClass="workspace-root">
    <left>
        <VBox prefWidth="276.0" spacing="10.0" styleClass="workspace-sidebar">
            <padding>
                <Insets top="24.0" right="16.0" bottom="16.0" left="16.0"/>
            </padding>
            <VBox spacing="4.0" styleClass="brand-shell">
                <Label text="WasteWise" styleClass="brand-logo-text"/>
            </VBox>
            <Label text="Menu Principal" styleClass="sidebar-section"/>
            <Button fx:id="navHome" text="Accueil" onAction="#handleDashboard" maxWidth="Infinity" styleClass="sidebar-nav muted"/>
            <Button fx:id="navDeclare" text="Declarer un dechet" onAction="#handleDeclareWaste" maxWidth="Infinity" styleClass="sidebar-nav muted"/>
            <Button fx:id="navMyDeclarations" text="Mes declarations" onAction="#handleMyDeclarations" maxWidth="Infinity" styleClass="sidebar-nav muted"/>
            <Button fx:id="navStatistics" text="Statistiques" onAction="#handleStatistics" maxWidth="Infinity" styleClass="sidebar-nav muted"/>
            <Button fx:id="navNews" text="Nouveautes" onAction="#handleNews" maxWidth="Infinity" styleClass="sidebar-nav muted"/>
            <Button fx:id="navAir" text="Air Quality" onAction="#handleAirQuality" maxWidth="Infinity" styleClass="sidebar-nav muted"/>
            <Button fx:id="navWithdraw" text="Withdraw" onAction="#handleWithdraw" maxWidth="Infinity" styleClass="sidebar-nav muted"/>
            <Button fx:id="navSettings" text="Parametres" onAction="#handleProfile" maxWidth="Infinity" styleClass="sidebar-nav muted"/>
            <Region VBox.vgrow="ALWAYS"/>
            <VBox spacing="2.0" styleClass="sidebar-footer">
                <Label fx:id="citizenNameLabel" text="Utilisateur Demo" styleClass="user-meta-name"/>
                <Label text="Citoyen" styleClass="user-meta-role"/>
            </VBox>
        </VBox>
    </left>
    <center>
        <VBox styleClass="workspace-main">
            <HBox spacing="12.0" alignment="CENTER_LEFT" styleClass="workspace-topbar">
                <Button text="Menu" styleClass="crumb-button"/>
                <Label text="Citoyen &gt;" styleClass="crumb-text"/>
                <Label text="Declarations" styleClass="crumb-text"/>
                <Label text="Mes declarations" styleClass="crumb-current"/>
                <Region HBox.hgrow="ALWAYS"/>
                <VBox alignment="CENTER_RIGHT" spacing="3.0">
                    <Label fx:id="headerEmailLabel" text="—" styleClass="workspace-title"/>
                    <Label text="Citoyen" styleClass="workspace-subtitle-strong"/>
                </VBox>
            </HBox>
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="content-scroll">
                <content>
                    <VBox spacing="18.0" styleClass="workspace-content">
                        <VBox spacing="10.0" styleClass="hero-panel">
                            <Label text="Mes declarations" styleClass="hero-title"/>
                            <Label text="Liste de vos signalements, du plus recent au plus ancien." styleClass="hero-subtitle"/>
                        </VBox>

                        <HBox spacing="12.0" alignment="CENTER_LEFT" styleClass="panel-card">
                            <padding>
                                <Insets top="12.0" right="16.0" bottom="12.0" left="16.0"/>
                            </padding>
                            <ComboBox fx:id="statusFilter" prefWidth="180.0"/>
                            <TextField fx:id="searchField" promptText="Rechercher (description, type...)" styleClass="input-field" HBox.hgrow="ALWAYS"/>
                            <Button text="Reinitialiser" onAction="#resetFilters" styleClass="outline-btn"/>
                        </HBox>

                        <Label fx:id="emptyHintLabel" managed="false" visible="false" wrapText="true" styleClass="workspace-subtitle-strong"/>

                        <VBox spacing="12.0" styleClass="panel-card">
                            <Label text="Historique" styleClass="panel-heading"/>
                            <TableView fx:id="declarationsTable" prefHeight="420.0">
                                <columns>
                                    <TableColumn fx:id="dateColumn" text="Date" prefWidth="160.0"/>
                                    <TableColumn fx:id="typeColumn" text="Type" prefWidth="180.0"/>
                                    <TableColumn fx:id="statutColumn" text="Statut" prefWidth="120.0"/>
                                    <TableColumn fx:id="quantiteColumn" text="Quantite" prefWidth="100.0"/>
                                    <TableColumn fx:id="qrPreviewColumn" text="QR" prefWidth="90.0"/>
                                    <TableColumn fx:id="actionColumn" text="Actions" prefWidth="260.0"/>
                                </columns>
                            </TableView>
                        </VBox>
                    </VBox>
                </content>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>
