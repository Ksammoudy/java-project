<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.web.WebView?>
<?import javafx.scene.text.Text?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controllers.MapController"
            styleClass="workspace-root"
            stylesheets="@../styles/style.css">

    <left>
        <VBox prefWidth="276.0" spacing="10.0" styleClass="workspace-sidebar">
            <padding>
                <Insets top="24.0" right="16.0" bottom="16.0" left="16.0"/>
            </padding>
            <VBox spacing="4.0" styleClass="brand-shell">
                <Label text="WasteWise" styleClass="brand-logo-text"/>
            </VBox>
            <Label text="Menu Principal" styleClass="sidebar-section"/>
            <Button text="📈 Dashboard" onAction="#goToDashboard" maxWidth="Infinity" styleClass="sidebar-nav muted"/>
            <Label text="Zones &amp; Impact" styleClass="sidebar-section"/>
            <Button text="📍 Zones Polluées" onAction="#goToZones" maxWidth="Infinity" styleClass="sidebar-nav muted"/>
            <Button text="📊 Indicateurs" onAction="#goToIndicateurs" maxWidth="Infinity" styleClass="sidebar-nav muted"/>
            <Button text="🗺️ Carte" maxWidth="Infinity" styleClass="sidebar-nav active"/>
            <Button text="📱 Scans QR" onAction="#goToQRDashboard" maxWidth="Infinity" styleClass="sidebar-nav muted"/>
            <Region VBox.vgrow="ALWAYS"/>
            <VBox spacing="2.0" styleClass="sidebar-footer">
                <Label text="Admin" styleClass="user-meta-name"/>
                <Label text="Administrateur" styleClass="user-meta-role"/>
            </VBox>
        </VBox>
    </left>

    <!-- MAIN CONTENT -->
    <center>
        <VBox styleClass="main-content" spacing="20" style="-fx-padding: 20;">

            <!-- Top Header -->
            <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 0 0 10 0;">
                <Label text="Dashboard / Carte interactive" style="-fx-font-size: 14px; -fx-text-fill: #6c757d;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="🔔" style="-fx-background-color: transparent;"/>
                <Button text="👤 Admin" style="-fx-background-color: transparent; -fx-font-weight: bold;"/>
            </HBox>

            <!-- Hero Banner -->
            <VBox styleClass="hero" spacing="10" style="-fx-background-color: linear-gradient(to right, #2f6b4f, #8bd22f); -fx-background-radius: 20; -fx-padding: 40;">
                <Label text="🗺️ Carte interactive des zones polluées" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <Label text="Visualisez toutes les zones polluées avec leurs niveaux de risque" style="-fx-text-fill: rgba(255,255,255,0.85);"/>
            </VBox>

            <!-- Contrôles de la carte - Première ligne -->
            <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 10 0;">
                <Button text="📍 Rafraîchir" styleClass="btn-green" onAction="#refreshMap"/>
                <Button text="🎯 Centrer" styleClass="btn-outline" onAction="#centerMap"/>
                <Button text="📍 Ma position" styleClass="btn-outline" onAction="#showMyLocation"/>
                <Button text="🔍 Rechercher" styleClass="btn-outline" onAction="#searchZone"/>
                <Button text="🔥 Heatmap" styleClass="btn-outline" onAction="#toggleHeatmap"/>
                <Button text="📏 Mesurer" styleClass="btn-outline" onAction="#startMeasurement"/>
                <Region HBox.hgrow="ALWAYS"/>
            </HBox>

            <!-- Contrôles de la carte - Deuxième ligne (Filtres) -->
            <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 0 0 10 0;">
                <Label text="Filtres : " style="-fx-font-weight: bold;"/>
                <Button text="🔴 Haut risque" styleClass="btn-outline" onAction="#filterHighRisk"/>
                <Button text="🟡 Risque moyen" styleClass="btn-outline" onAction="#filterMediumRisk"/>
                <Button text="🟢 Risque faible" styleClass="btn-outline" onAction="#filterLowRisk"/>
                <Button text="👁️ Toutes les zones" styleClass="btn-green" onAction="#showAllZones"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Légende : " style="-fx-font-weight: bold;"/>
                <Label text="🔴 Haut (≥7)" style="-fx-text-fill: #dc3545;"/>
                <Label text="🟡 Moyen (4-6)" style="-fx-text-fill: #ffc107;"/>
                <Label text="🟢 Faible (≤3)" style="-fx-text-fill: #28a745;"/>
            </HBox>

            <!-- Carte Leaflet -->
            <WebView fx:id="mapWebView" VBox.vgrow="ALWAYS" prefHeight="550"/>

        </VBox>
    </center>
</BorderPane>