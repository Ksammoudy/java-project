<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controllers.AppShellController"
            styleClass="workspace-root"
            stylesheets="@../styles/style.css">

    <!-- ═══════════════════════════════════════════
         SIDEBAR GLOBALE — reste toujours visible
         ═══════════════════════════════════════════ -->
    <left>
        <VBox fx:id="sidebar" prefWidth="276.0" spacing="10.0" styleClass="workspace-sidebar">
            <padding>
                <Insets top="24.0" right="16.0" bottom="16.0" left="16.0"/>
            </padding>

            <!-- Brand -->
            <VBox spacing="4.0" styleClass="brand-shell">
                <Label text="WasteWise" styleClass="brand-logo-text"/>
                <Label fx:id="brandSubtitle" text="Espace Admin" styleClass="brand-subtitle"/>
            </VBox>

            <!-- ── Section Admin ── -->
            <VBox fx:id="sectionAdmin" managed="false" visible="false" spacing="0">
                <Label text="Menu Principal" styleClass="sidebar-section"/>
                <Button fx:id="btnAdminDashboard"   text="📈 Dashboard"        onAction="#navAdminDashboard"   maxWidth="Infinity" styleClass="sidebar-nav"/>
                <Label text="Gestion déchets" styleClass="sidebar-section"/>
                <Button fx:id="btnTypeDechet"        text="♻ Types de déchets"  onAction="#navTypeDechet"        maxWidth="Infinity" styleClass="sidebar-nav"/>
                <Button fx:id="btnDeclarations"      text="📋 Déclarations"     onAction="#navDeclarations"      maxWidth="Infinity" styleClass="sidebar-nav"/>
                <Label text="Administration" styleClass="sidebar-section"/>
                <Button fx:id="btnUsers"             text="👥 Utilisateurs"     onAction="#navUsers"             maxWidth="Infinity" styleClass="sidebar-nav"/>
                <Label text="Zones &amp; Impact" styleClass="sidebar-section"/>
                <Button fx:id="btnZones"             text="📍 Zones Polluées"   onAction="#navZones"             maxWidth="Infinity" styleClass="sidebar-nav"/>
                <Button fx:id="btnIndicateurs"       text="📊 Indicateurs"      onAction="#navIndicateurs"       maxWidth="Infinity" styleClass="sidebar-nav"/>
                <Button fx:id="btnCarte"             text="🗺️ Carte"            onAction="#navCarte"             maxWidth="Infinity" styleClass="sidebar-nav"/>
                <Button fx:id="btnQR"                text="📱 Scans QR"         onAction="#navQR"                maxWidth="Infinity" styleClass="sidebar-nav"/>
                <Button fx:id="btnAdvanced"          text="📊 Dashboard Avancé" onAction="#navAdvanced"          maxWidth="Infinity" styleClass="sidebar-nav"/>
                <Button fx:id="btnChatbot"           text="🤖 Assistant IA"     onAction="#navChatbot"           maxWidth="Infinity" styleClass="sidebar-nav"/>
            </VBox>

            <!-- ── Section Citoyen ── -->
            <VBox fx:id="sectionCitoyen" managed="false" visible="false" spacing="0">
                <Label text="Menu Principal" styleClass="sidebar-section"/>
                <Button fx:id="btnCitoyenDashboard"  text="🏠 Accueil"          onAction="#navCitoyenDashboard"  maxWidth="Infinity" styleClass="sidebar-nav"/>
                <Button fx:id="btnDeclarer"          text="📦 Déclarer déchet"  onAction="#navDeclarer"          maxWidth="Infinity" styleClass="sidebar-nav"/>
                <Button fx:id="btnMesDeclarations"   text="📋 Mes déclarations" onAction="#navMesDeclarations"   maxWidth="Infinity" styleClass="sidebar-nav"/>
                <Button fx:id="btnStatistiques"      text="📈 Statistiques"     onAction="#navStatistiques"      maxWidth="Infinity" styleClass="sidebar-nav"/>
                <Button fx:id="btnProfil"            text="👤 Profil"           onAction="#navProfil"            maxWidth="Infinity" styleClass="sidebar-nav"/>
            </VBox>

            <!-- ── Section Valorisateur ── -->
            <VBox fx:id="sectionValorisateur" managed="false" visible="false" spacing="0">
                <Label text="Menu Principal" styleClass="sidebar-section"/>
                <Button fx:id="btnValoDashboard"     text="🏠 Accueil"          onAction="#navValoDashboard"     maxWidth="Infinity" styleClass="sidebar-nav"/>
                <Button fx:id="btnDechetsRecus"      text="📦 Déchets reçus"    onAction="#navDechetsRecus"      maxWidth="Infinity" styleClass="sidebar-nav"/>
                <Button fx:id="btnValorisation"      text="♻ Valorisation"      onAction="#navValorisation"      maxWidth="Infinity" styleClass="sidebar-nav"/>
                <Button fx:id="btnValoStats"         text="📈 Statistiques"     onAction="#navValoStats"         maxWidth="Infinity" styleClass="sidebar-nav"/>
                <Button fx:id="btnValoProfile"       text="👤 Profil"           onAction="#navValoProfile"       maxWidth="Infinity" styleClass="sidebar-nav"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- Footer utilisateur -->
            <VBox spacing="2.0" styleClass="sidebar-footer">
                <Label fx:id="footerName" text="Utilisateur" styleClass="user-meta-name"/>
                <Label fx:id="footerRole" text="Rôle"        styleClass="user-meta-role"/>
                <Button text="🚪 Déconnexion" onAction="#handleLogout"
                        maxWidth="Infinity"
                        style="-fx-background-color: transparent; -fx-text-fill: #ef4b5a; -fx-font-size: 13px; -fx-cursor: hand;"/>
            </VBox>
        </VBox>
    </left>

    <!-- ═══════════════════════════════════════════
         ZONE CENTRALE — le contenu change ici
         ═══════════════════════════════════════════ -->
    <center>
        <StackPane fx:id="contentArea" styleClass="workspace-main"/>
    </center>

</BorderPane>
