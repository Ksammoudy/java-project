<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="rootPane"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controllers.ProfileController"
            styleClass="content-scroll"
            stylesheets="/org/example/styles/style.css">

    <center>
        <VBox spacing="30.0" styleClass="workspace-content">
            
            <!-- En-tête de la page -->
            <VBox spacing="8.0">
                <HBox alignment="CENTER_LEFT" spacing="16.0">
                    <Label text="✏️ Modifier mon Profil" styleClass="workspace-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                </HBox>
                <Label text="Mettez à jour vos informations personnelles et votre mot de passe." styleClass="workspace-subtitle-strong"/>
            </VBox>

            <!-- Formulaire Principal -->
            <VBox spacing="25.0" styleClass="panel-card" maxWidth="800">
                <padding>
                    <Insets top="30" right="40" bottom="30" left="40"/>
                </padding>
                
                <Label text="Informations Générales" styleClass="panel-heading"/>
                
                <HBox spacing="24.0">
                    <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                        <Label text="Nom de famille" styleClass="field-label"/>
                        <TextField fx:id="nomField" promptText="Saisissez votre nom" styleClass="input-field"/>
                    </VBox>

                    <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                        <Label text="Prénom" styleClass="field-label"/>
                        <TextField fx:id="prenomField" promptText="Saisissez votre prénom" styleClass="input-field"/>
                    </VBox>
                </HBox>

                <HBox spacing="24.0">
                    <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                        <Label text="Numéro de Téléphone" styleClass="field-label"/>
                        <TextField fx:id="telephoneField" promptText="Ex: 12345678" styleClass="input-field"/>
                    </VBox>

                    <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                        <Label text="Adresse Email" styleClass="field-label"/>
                        <TextField fx:id="emailField" promptText="Ex: email@domaine.com" styleClass="input-field"/>
                    </VBox>
                </HBox>

                <!-- Séparateur horizontal -->
                <Region style="-fx-background-color: #eef2f3; -fx-pref-height: 1px; -fx-min-height: 1px;"/>

                <Label text="🔐 Sécurité du Compte" styleClass="panel-heading"/>

                <VBox spacing="16.0">
                    <VBox spacing="8.0" maxWidth="380">
                        <Label text="Mot de passe actuel" styleClass="field-label"/>
                        <PasswordField fx:id="currentPasswordField"
                                       promptText="Saisissez votre mot de passe actuel"
                                       styleClass="input-field"/>
                    </VBox>

                    <HBox spacing="24.0">
                        <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                            <Label text="Nouveau mot de passe" styleClass="field-label"/>
                            <PasswordField fx:id="newPasswordField"
                                           promptText="Nouveau mot de passe (min. 6 caractères)"
                                           styleClass="input-field"/>
                        </VBox>

                        <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                            <Label text="Confirmer le nouveau mot de passe" styleClass="field-label"/>
                            <PasswordField fx:id="confirmPasswordField"
                                           promptText="Répétez le mot de passe"
                                           styleClass="input-field"/>
                        </VBox>
                    </HBox>
                    
                    <Label text="ℹ️ Laissez les champs vides si vous ne souhaitez pas modifier votre mot de passe."
                           style="-fx-font-size: 13px; -fx-text-fill: #73808d; -fx-padding: 4 0 0 0;"/>
                </VBox>

                <!-- Affichage des messages de statut (Succès ou Erreur) -->
                <Label fx:id="messageLabel"
                       text=""
                       wrapText="true"
                       styleClass="message-label"
                       style="-fx-font-size: 14px; -fx-padding: 8 0 0 0;"/>

                <!-- Actions du bas -->
                <HBox spacing="15.0" alignment="CENTER_LEFT" style="-fx-padding: 15 0 0 0;">
                    <Button text="💾 Enregistrer les modifications" onAction="#handleSaveProfile" styleClass="primary-btn"/>
                    
                    <Region HBox.hgrow="ALWAYS"/>
                    
                    <Button text="👤 Annuler et voir mon profil" onAction="#handleViewProfilePage" styleClass="outline-btn"/>
                    <Button text="↩ Retour au dashboard" onAction="#handleBackToDashboard" styleClass="ghost-btn"/>
                </HBox>
            </VBox>

        </VBox>
    </center>
</BorderPane>

