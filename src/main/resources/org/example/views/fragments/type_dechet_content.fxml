<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controllers.TypeDechetWorkshopController"
      styleClass="workspace-main">

    <HBox spacing="12.0" alignment="CENTER_LEFT" styleClass="workspace-topbar">
        <Label text="Types de déchets" styleClass="workspace-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="+ Ajouter un type" onAction="#handleInsert" styleClass="primary-btn"/>
    </HBox>

    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS" styleClass="content-scroll">
        <content>
            <VBox spacing="18.0" styleClass="workspace-content">
                <VBox spacing="10.0" styleClass="hero-panel">
                    <Label text="Gestion des types de dechet" styleClass="hero-title"/>
                    <Label text="Configurez les categories utilisees dans les declarations citoyennes." styleClass="hero-subtitle"/>
                </VBox>

                <HBox fx:id="bannerBox" spacing="10.0" alignment="CENTER_LEFT" styleClass="success-banner" managed="false" visible="false">
                    <Label fx:id="bannerLabel" text="" styleClass="success-banner-text"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="X" onAction="#closeBanner" styleClass="ghost-btn"/>
                </HBox>

                <HBox spacing="18.0">
                    <VBox prefWidth="220.0" spacing="10.0" styleClass="metric-card">
                        <Label text="Total types" styleClass="metric-label"/>
                        <Label fx:id="totalTypesLabel" text="0" styleClass="metric-value"/>
                    </VBox>
                </HBox>

                <VBox spacing="12.0" styleClass="table-card">
                    <TableView fx:id="typeTable" prefHeight="420.0">
                        <columns>
                            <TableColumn fx:id="idColumn" text="ID" prefWidth="70.0"/>
                            <TableColumn fx:id="libelleColumn" text="Libelle" prefWidth="220.0"/>
                            <TableColumn fx:id="pointsColumn" text="Points/kg" prefWidth="140.0"/>
                            <TableColumn fx:id="descriptionColumn" text="Description tri" prefWidth="400.0"/>
                            <TableColumn fx:id="actionsColumn" text="Actions" prefWidth="260.0"/>
                        </columns>
                    </TableView>
                </VBox>
            </VBox>
        </content>
    </ScrollPane>
</VBox>
