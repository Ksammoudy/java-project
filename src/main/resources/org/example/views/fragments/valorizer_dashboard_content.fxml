<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controllers.DashboardValorizerController"
      styleClass="workspace-main">

    <HBox spacing="12.0" alignment="CENTER_LEFT" styleClass="workspace-topbar">
        <Label text="Dashboard Valorisateur" styleClass="workspace-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="valorizerHeaderNameLabel" text="Valorisateur" styleClass="workspace-subtitle-strong"/>
    </HBox>

    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS" styleClass="content-scroll">
        <content>
            <VBox spacing="18.0" styleClass="workspace-content">
                <HBox alignment="CENTER_LEFT" styleClass="hero-panel">
                    <VBox spacing="10.0">
                        <Label text="Bienvenue Valorisateur" styleClass="hero-title"/>
                        <Label text="Optimisez la valorisation des dechets collectes." styleClass="hero-subtitle"/>
                    </VBox>
                </HBox>

                <HBox spacing="18.0">
                    <VBox HBox.hgrow="ALWAYS" spacing="10.0" styleClass="stat-card">
                        <Label text="Dechets recus" styleClass="stat-title"/>
                        <Label text="540 kg" styleClass="stat-value-large"/>
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" spacing="10.0" styleClass="stat-card">
                        <Label text="Dechets valorises" styleClass="stat-title"/>
                        <Label text="410 kg" styleClass="stat-value-large"/>
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" spacing="10.0" styleClass="stat-card">
                        <Label text="Rendement" styleClass="stat-title"/>
                        <Label text="76%" styleClass="stat-value-large"/>
                    </VBox>
                </HBox>

                <HBox spacing="18.0">
                    <VBox HBox.hgrow="ALWAYS" spacing="14.0" styleClass="panel-card">
                        <Label text="Valorisation des declarations approuvees" styleClass="panel-heading"/>
                        <BarChart fx:id="valorisationChart" legendVisible="false" prefHeight="280.0">
                            <xAxis><CategoryAxis/></xAxis>
                            <yAxis><NumberAxis/></yAxis>
                        </BarChart>
                    </VBox>
                </HBox>
            </VBox>
        </content>
    </ScrollPane>
</VBox>
