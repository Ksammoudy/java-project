<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controllers.ProfileController"
      styleClass="workspace-main">

    <HBox spacing="12.0" alignment="CENTER_LEFT" styleClass="workspace-topbar">
        <Label text="Mon Profil" styleClass="workspace-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="✏ Modifier" onAction="#handleEdit" styleClass="primary-btn"/>
    </HBox>

    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS" styleClass="content-scroll">
        <content>
            <VBox spacing="18.0" styleClass="workspace-content">
                <HBox alignment="CENTER_LEFT" styleClass="hero-panel">
                    <VBox spacing="10.0">
                        <Label text="Mon Profil" styleClass="hero-title"/>
                        <Label text="Gérez vos informations personnelles." styleClass="hero-subtitle"/>
                    </VBox>
                </HBox>

                <VBox spacing="16" styleClass="panel-card">
                    <Label text="Informations" styleClass="panel-heading"/>
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Label text="Email :" styleClass="field-label" prefWidth="120"/>
                        <Label fx:id="emailLabel" text="—" styleClass="body-text"/>
                    </HBox>
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Label text="Nom :" styleClass="field-label" prefWidth="120"/>
                        <Label fx:id="nomLabel" text="—" styleClass="body-text"/>
                    </HBox>
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Label text="Prénom :" styleClass="field-label" prefWidth="120"/>
                        <Label fx:id="prenomLabel" text="—" styleClass="body-text"/>
                    </HBox>
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Label text="Téléphone :" styleClass="field-label" prefWidth="120"/>
                        <Label fx:id="telephoneLabel" text="—" styleClass="body-text"/>
                    </HBox>
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Label text="Type :" styleClass="field-label" prefWidth="120"/>
                        <Label fx:id="typeLabel" text="—" styleClass="body-text"/>
                    </HBox>
                </VBox>
            </VBox>
        </content>
    </ScrollPane>
</VBox>
