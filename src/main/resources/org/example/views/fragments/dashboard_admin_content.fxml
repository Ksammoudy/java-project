<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controllers.DashboardAdminController"
      styleClass="workspace-main">

    <HBox spacing="12.0" alignment="CENTER_LEFT" styleClass="workspace-topbar">
        <Label text="Dashboard Admin" styleClass="workspace-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <VBox alignment="CENTER_RIGHT" spacing="3.0">
            <Label fx:id="adminHeaderNameLabel" text="Admin" styleClass="workspace-subtitle-strong"/>
        </VBox>
    </HBox>

    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS" styleClass="content-scroll">
        <content>
            <VBox spacing="18.0" styleClass="workspace-content">
                <HBox alignment="CENTER_LEFT" styleClass="hero-panel">
                    <VBox spacing="10.0">
                        <Label text="Bienvenue Admin" styleClass="hero-title"/>
                        <Label text="Utilisez le menu a gauche pour gerer l'application." styleClass="hero-subtitle"/>
                    </VBox>
                </HBox>

                <HBox spacing="18.0">
                    <VBox HBox.hgrow="ALWAYS" spacing="8.0" styleClass="strip-card weather-card">
                        <Label text="Meteo actuelle - Tunis" styleClass="weather-title"/>
                        <Label fx:id="weatherValueLabel" text="16C" styleClass="weather-value"/>
                        <Label fx:id="weatherMetaLabel" text="Vent: 2.5 km/h" styleClass="weather-meta"/>
                    </VBox>
                </HBox>

                <HBox spacing="18.0">
                    <VBox HBox.hgrow="ALWAYS" spacing="10.0" styleClass="stat-card">
                        <Label text="DÉCLARATIONS" styleClass="stat-title"/>
                        <Label fx:id="declarationsCountLabel" text="0" styleClass="stat-value-large"/>
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" spacing="10.0" styleClass="stat-card">
                        <Label text="EN ATTENTE" styleClass="stat-title"/>
                        <Label fx:id="pendingCountLabel" text="0" styleClass="stat-value-large"/>
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" spacing="10.0" styleClass="stat-card">
                        <Label text="TYPES DE DÉCHETS" styleClass="stat-title"/>
                        <Label fx:id="typesCountLabel" text="0" styleClass="stat-value-large"/>
                    </VBox>
                </HBox>

                <HBox spacing="18.0">
                    <VBox HBox.hgrow="ALWAYS" spacing="14.0" styleClass="panel-card">
                        <Label text="Declarations par type" styleClass="panel-heading"/>
                        <BarChart fx:id="declarationTypeChart" legendVisible="false" prefHeight="280.0">
                            <xAxis><CategoryAxis/></xAxis>
                            <yAxis><NumberAxis/></yAxis>
                        </BarChart>
                    </VBox>
                    <VBox prefWidth="360.0" spacing="14.0" styleClass="insight-card">
                        <Label text="Intelligence" styleClass="panel-heading"/>
                        <HBox>
                            <Label text="Type le plus declare:" styleClass="metric-label"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="topTypeLabel" text="—" styleClass="metric-value"/>
                        </HBox>
                    </VBox>
                </HBox>

                <HBox spacing="18.0">
                    <VBox HBox.hgrow="ALWAYS" spacing="14.0" styleClass="panel-card">
                        <Label text="Repartition des statuts" styleClass="panel-heading"/>
                        <PieChart fx:id="statusPieChart" prefHeight="280.0"/>
                    </VBox>
                </HBox>
            </VBox>
        </content>
    </ScrollPane>
</VBox>
