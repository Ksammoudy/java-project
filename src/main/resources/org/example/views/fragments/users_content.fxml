<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controllers.UserController"
      styleClass="workspace-main">

    <HBox spacing="12.0" alignment="CENTER_LEFT" styleClass="workspace-topbar">
        <Label text="Gestion des utilisateurs" styleClass="workspace-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="totalUsersLabel" text="0 utilisateurs" styleClass="workspace-subtitle-strong"/>
    </HBox>

    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS" styleClass="content-scroll">
        <content>
            <VBox spacing="18.0" styleClass="workspace-content">
                <HBox alignment="CENTER_LEFT" styleClass="hero-panel">
                    <VBox spacing="10.0">
                        <Label text="Utilisateurs" styleClass="hero-title"/>
                        <Label text="Gérez les comptes utilisateurs de la plateforme." styleClass="hero-subtitle"/>
                    </VBox>
                </HBox>

                <VBox spacing="14.0" styleClass="filter-card">
                    <HBox spacing="12.0" alignment="CENTER_LEFT">
                        <TextField fx:id="searchField" promptText="Rechercher..." HBox.hgrow="ALWAYS" styleClass="input-field"/>
                        <ComboBox fx:id="typeFilterComboBox" promptText="Tous types" prefWidth="160.0"/>
                        <ComboBox fx:id="statusFilterComboBox" promptText="Tous statuts" prefWidth="140.0"/>
                        <Button text="Rechercher" onAction="#handleSearch" styleClass="primary-btn"/>
                        <Button text="Rafraîchir" onAction="#handleRefreshUsers" styleClass="outline-btn"/>
                    </HBox>
                </VBox>

                <VBox spacing="12.0" styleClass="table-card">
                    <HBox alignment="CENTER_LEFT">
                        <Label fx:id="pageMessageLabel" text="" styleClass="success-text"/>
                    </HBox>
                    <TableView fx:id="usersTable" prefHeight="480.0">
                        <columns>
                            <TableColumn fx:id="emailColumn" text="Email" prefWidth="220.0"/>
                            <TableColumn fx:id="fullNameColumn" text="Nom complet" prefWidth="180.0"/>
                            <TableColumn fx:id="phoneColumn" text="Téléphone" prefWidth="130.0"/>
                            <TableColumn fx:id="typeColumn" text="Type" prefWidth="130.0"/>
                            <TableColumn fx:id="statusColumn" text="Statut" prefWidth="100.0"/>
                            <TableColumn fx:id="createdAtColumn" text="Créé le" prefWidth="150.0"/>
                        </columns>
                    </TableView>
                    <HBox spacing="10.0">
                        <Button text="✏ Modifier" onAction="#handleEditUser" styleClass="outline-btn"/>
                        <Button text="🔄 Activer/Désactiver" onAction="#handleToggleUser" styleClass="outline-btn"/>
                        <Button text="🗑 Supprimer" onAction="#handleDeleteUser" styleClass="danger-btn"/>
                    </HBox>
                </VBox>
            </VBox>
        </content>
    </ScrollPane>
</VBox>
