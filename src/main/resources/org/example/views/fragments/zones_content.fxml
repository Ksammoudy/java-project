<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controllers.ZonePollueeController"
      styleClass="workspace-main">

    <HBox spacing="12.0" alignment="CENTER_LEFT" styleClass="workspace-topbar">
        <Label text="Zones Polluées" styleClass="workspace-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="➕ Nouvelle Zone" styleClass="primary-btn" onAction="#addZone"/>
    </HBox>

    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS" styleClass="content-scroll">
        <content>
            <VBox spacing="18.0" styleClass="workspace-content">
                <VBox styleClass="hero-panel" spacing="10">
                    <Label text="Gestion des Zones Polluées" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    <Label text="Suivi et analyse des zones à risque" style="-fx-text-fill: rgba(255,255,255,0.85);"/>
                </VBox>

                <HBox spacing="20">
                    <VBox styleClass="stat-card" spacing="10" HBox.hgrow="ALWAYS">
                        <Text text="📍" style="-fx-font-size: 24px;"/>
                        <Text fx:id="totalZonesText" style="-fx-font-size: 24px; -fx-font-weight: bold;">0</Text>
                        <Text text="Zones Polluées" style="-fx-fill: #6c757d; -fx-font-size: 12px;"/>
                    </VBox>
                    <VBox styleClass="stat-card" spacing="10" HBox.hgrow="ALWAYS">
                        <Text text="⚠️" style="-fx-font-size: 24px;"/>
                        <Text fx:id="hautRisqueText" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-fill: #dc3545;">0</Text>
                        <Text text="Haut Risque" style="-fx-fill: #6c757d; -fx-font-size: 12px;"/>
                    </VBox>
                    <VBox styleClass="stat-card" spacing="10" HBox.hgrow="ALWAYS">
                        <Text text="📅" style="-fx-font-size: 24px;"/>
                        <Text fx:id="nouvellesZonesText" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-fill: #28a745;">0</Text>
                        <Text text="Nouvelles (7j)" style="-fx-fill: #6c757d; -fx-font-size: 12px;"/>
                    </VBox>
                </HBox>

                <HBox spacing="10">
                    <TextField fx:id="searchField" promptText="🔍 Rechercher par nom ou GPS..." HBox.hgrow="ALWAYS" styleClass="input-field"/>
                    <ComboBox fx:id="filterCombo" prefWidth="180"/>
                    <Button text="Filtrer" styleClass="primary-btn" onAction="#loadZones"/>
                </HBox>

                <VBox styleClass="table-card" spacing="15">
                    <TableView fx:id="zoneTable" prefHeight="400">
                        <columns>
                            <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
                            <TableColumn fx:id="colNom" text="Zone" prefWidth="180"/>
                            <TableColumn fx:id="colGps" text="Coordonnées" prefWidth="180"/>
                            <TableColumn fx:id="colNiveau" text="Niveau" prefWidth="80"/>
                            <TableColumn fx:id="colDate" text="Date" prefWidth="150"/>
                            <TableColumn fx:id="colIndicateur" text="Indicateur" prefWidth="120"/>
                            <TableColumn fx:id="colActions" text="Actions" prefWidth="150"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>
                </VBox>
            </VBox>
        </content>
    </ScrollPane>
</VBox>
