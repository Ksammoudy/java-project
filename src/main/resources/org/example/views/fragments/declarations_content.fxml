<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controllers.DeclarationDechetListController"
      styleClass="workspace-main">

    <HBox spacing="12.0" alignment="CENTER_LEFT" styleClass="workspace-topbar">
        <Label text="Déclarations" styleClass="workspace-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="syncLabel" text="" styleClass="workspace-subtitle-strong"/>
    </HBox>

    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS" styleClass="content-scroll">
        <content>
            <VBox spacing="18.0" styleClass="workspace-content">
                <HBox alignment="CENTER_LEFT" styleClass="hero-panel">
                    <VBox spacing="10.0">
                        <Label text="Gestion des declarations" styleClass="hero-title"/>
                        <Label text="Consultez et suivez les declarations recues." styleClass="hero-subtitle"/>
                    </VBox>
                </HBox>

                <HBox fx:id="flashMessageBox" spacing="10.0" alignment="CENTER_LEFT" styleClass="success-banner" managed="false" visible="false">
                    <Label fx:id="flashMessageLabel" text="" styleClass="success-banner-text"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="X" onAction="#closeFlash" styleClass="ghost-btn"/>
                </HBox>

                <HBox spacing="18.0">
                    <VBox HBox.hgrow="ALWAYS" spacing="10.0" styleClass="stat-card">
                        <Label text="Total" styleClass="stat-title"/>
                        <Label fx:id="totalLabel" text="0" styleClass="stat-value-large"/>
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" spacing="10.0" styleClass="stat-card">
                        <Label text="Approuvees" styleClass="stat-title"/>
                        <Label fx:id="approvedCountLabel" text="0" styleClass="stat-value-large"/>
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" spacing="10.0" styleClass="stat-card">
                        <Label text="En attente" styleClass="stat-title"/>
                        <Label fx:id="pendingCountLabel" text="0" styleClass="stat-value-large"/>
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" spacing="10.0" styleClass="stat-card">
                        <Label text="EcoPoints" styleClass="stat-title"/>
                        <Label fx:id="ecoPointsLabel" text="0" styleClass="stat-value-large"/>
                    </VBox>
                </HBox>

                <VBox spacing="14.0" styleClass="filter-card">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="Filtres" styleClass="panel-heading"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="Reset" onAction="#resetFilters" styleClass="outline-btn"/>
                        <Button text="Rafraichir" onAction="#refreshDeclarations" styleClass="outline-btn"/>
                    </HBox>
                    <HBox spacing="12.0">
                        <TextField fx:id="searchField" promptText="Recherche citoyen..." HBox.hgrow="ALWAYS" styleClass="input-field"/>
                        <ComboBox fx:id="statusFilter" promptText="Tous statuts" prefWidth="180.0"/>
                        <ComboBox fx:id="typeFilter" promptText="Tous types" prefWidth="180.0"/>
                        <ComboBox fx:id="sortFilter" promptText="Date desc" prefWidth="180.0"/>
                    </HBox>
                </VBox>

                <VBox spacing="14.0" styleClass="table-card">
                    <TableView fx:id="declarationTable" prefHeight="460.0">
                        <columns>
                            <TableColumn fx:id="idColumn" text="ID" prefWidth="64.0"/>
                            <TableColumn fx:id="photoColumn" text="Photo" prefWidth="90.0"/>
                            <TableColumn fx:id="citoyenColumn" text="Citoyen" prefWidth="200.0"/>
                            <TableColumn fx:id="typeColumn" text="Type" prefWidth="180.0"/>
                            <TableColumn fx:id="quantiteColumn" text="Quantite" prefWidth="100.0"/>
                            <TableColumn fx:id="dateColumn" text="Date" prefWidth="120.0"/>
                            <TableColumn fx:id="statutColumn" text="Statut" prefWidth="130.0"/>
                            <TableColumn fx:id="actionsColumn" text="Actions" prefWidth="220.0"/>
                        </columns>
                    </TableView>
                </VBox>
            </VBox>
        </content>
    </ScrollPane>
</VBox>
