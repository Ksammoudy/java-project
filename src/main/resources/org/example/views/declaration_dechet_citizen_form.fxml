<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controllers.DeclarationDechetCitizenFormController"
            styleClass="workspace-root">
    <left>
        <VBox prefWidth="276.0" spacing="10.0" styleClass="workspace-sidebar">
            <padding>
                <Insets top="24.0" right="16.0" bottom="16.0" left="16.0"/>
            </padding>
            <VBox spacing="4.0" styleClass="brand-shell">
                <Label text="WasteWise" styleClass="brand-logo-text"/>
            </VBox>
            <Label text="Menu Principal" styleClass="sidebar-section"/>
            <Button fx:id="navHome" text="Accueil" onAction="#handleDashboard" maxWidth="Infinity" styleClass="sidebar-nav muted"/>
            <Button fx:id="navDeclare" text="Declarer un dechet" onAction="#handleDeclareWaste" maxWidth="Infinity" styleClass="sidebar-nav muted"/>
            <Button fx:id="navMyDeclarations" text="Mes declarations" onAction="#handleMyDeclarations" maxWidth="Infinity" styleClass="sidebar-nav muted"/>
            <Button fx:id="navStatistics" text="Statistiques" onAction="#handleStatistics" maxWidth="Infinity" styleClass="sidebar-nav muted"/>
            <Button fx:id="navNews" text="Nouveautes" onAction="#handleNews" maxWidth="Infinity" styleClass="sidebar-nav muted"/>
            <Button fx:id="navAir" text="Air Quality" onAction="#handleAirQuality" maxWidth="Infinity" styleClass="sidebar-nav muted"/>
            <Button fx:id="navWithdraw" text="Withdraw" onAction="#handleWithdraw" maxWidth="Infinity" styleClass="sidebar-nav muted"/>
            <Button fx:id="navSettings" text="Parametres" onAction="#handleProfile" maxWidth="Infinity" styleClass="sidebar-nav muted"/>
            <Region VBox.vgrow="ALWAYS"/>
            <VBox spacing="2.0" styleClass="sidebar-footer">
                <Label fx:id="citizenNameLabel" text="Utilisateur Demo" styleClass="user-meta-name"/>
                <Label text="Citoyen" styleClass="user-meta-role"/>
            </VBox>
        </VBox>
    </left>
    <center>
        <VBox styleClass="workspace-main">
            <HBox spacing="12.0" alignment="CENTER_LEFT" styleClass="workspace-topbar">
                <Button text="Menu" styleClass="crumb-button"/>
                <Label text="Citoyen &gt;" styleClass="crumb-text"/>
                <Label text="Declarations" styleClass="crumb-text"/>
                <Label text="Nouvelle declaration" styleClass="crumb-current"/>
                <Region HBox.hgrow="ALWAYS"/>
                <VBox alignment="CENTER_RIGHT" spacing="3.0">
                    <Label fx:id="headerEmailLabel" text="--" styleClass="workspace-title"/>
                    <Label text="Citoyen" styleClass="workspace-subtitle-strong"/>
                </VBox>
            </HBox>
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="content-scroll">
                <content>
                    <VBox spacing="18.0" styleClass="workspace-content">
                        <VBox spacing="10.0" styleClass="hero-panel">
                            <Label text="Declarer un dechet" styleClass="hero-title"/>
                            <Label text="Decrivez le dechet, ajoutez une photo et la localisation pour faciliter la collecte."
                                   styleClass="hero-subtitle"/>
                        </VBox>

                        <HBox fx:id="summaryErrorBox" spacing="10.0" alignment="CENTER_LEFT" styleClass="error-banner" managed="false" visible="false">
                            <Label fx:id="validationLabel" wrapText="true" styleClass="error-banner-text"/>
                        </HBox>

                        <VBox spacing="16.0" styleClass="panel-card">
                            <Label text="Informations principales" styleClass="panel-heading"/>

                            <VBox spacing="8.0">
                                <Label text="Type de dechet *" styleClass="field-label"/>
                                <ComboBox fx:id="typeDechetCombo" maxWidth="Infinity" styleClass="input-field" promptText="Choisir un type"/>
                                <Label fx:id="typeErrorLabel" managed="false" visible="false" text="" styleClass="error-text"/>
                            </VBox>

                            <HBox spacing="16.0">
                                <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                    <Label text="Quantite *" styleClass="field-label"/>
                                    <TextField fx:id="quantiteField" promptText="Ex: 2.5" styleClass="input-field"/>
                                    <Label fx:id="quantiteErrorLabel" managed="false" visible="false" text="" styleClass="error-text"/>
                                </VBox>
                                <VBox spacing="8.0" prefWidth="160.0">
                                    <Label text="Unite *" styleClass="field-label"/>
                                    <ComboBox fx:id="uniteCombo" maxWidth="Infinity" styleClass="input-field"/>
                                    <Label fx:id="uniteErrorLabel" managed="false" visible="false" text="" styleClass="error-text"/>
                                </VBox>
                            </HBox>

                            <VBox spacing="8.0">
                                <Label text="Description *" styleClass="field-label"/>
                                <TextArea fx:id="descriptionArea" prefRowCount="5" wrapText="true" styleClass="text-area"
                                          promptText="Minimum 10 caracteres : contexte, lieu, etat du dechet..."/>
                                <Label fx:id="descriptionErrorLabel" managed="false" visible="false" text="" styleClass="error-text"/>
                            </VBox>

                            <VBox spacing="8.0">
                                <Label text="Photo (optionnelle)" styleClass="field-label"/>
                                <HBox spacing="12.0" alignment="CENTER_LEFT">
                                    <Button text="Parcourir..." onAction="#handleBrowsePhoto" styleClass="outline-btn"/>
                                    <Button text="Retirer" onAction="#handleClearPhoto" styleClass="outline-btn"/>
                                    <Label fx:id="photoHintLabel" text="Aucun fichier selectionne" styleClass="workspace-subtitle-strong"/>
                                </HBox>
                            </VBox>

                            <HBox spacing="16.0">
                                <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                    <Label text="Latitude *" styleClass="field-label"/>
                                    <TextField fx:id="latitudeField" promptText="-90 a 90" styleClass="input-field"/>
                                </VBox>
                                <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                    <Label text="Longitude *" styleClass="field-label"/>
                                    <TextField fx:id="longitudeField" promptText="-180 a 180" styleClass="input-field"/>
                                </VBox>
                            </HBox>
                            <Label fx:id="geoErrorLabel" managed="false" visible="false" text="" styleClass="error-text"/>

                            <VBox spacing="8.0">
                                <Label text="Score IA (optionnel, 0 a 1)" styleClass="field-label"/>
                                <TextField fx:id="scoreIaField" promptText="Ex: 0.85" styleClass="input-field"/>
                                <Label fx:id="scoreErrorLabel" managed="false" visible="false" text="" styleClass="error-text"/>
                            </VBox>

                            <HBox spacing="12.0">
                                <Button text="Enregistrer la declaration" onAction="#handleSubmit" styleClass="primary-btn"/>
                                <Button text="Annuler" onAction="#handleCancel" styleClass="outline-btn"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button text="Deconnexion" onAction="#handleLogout" styleClass="outline-btn"/>
                            </HBox>
                        </VBox>
                    </VBox>
                </content>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>


