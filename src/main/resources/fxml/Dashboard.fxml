<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.web.WebView?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="main.controllers.DashboardController"
      style="-fx-background-color: #EEF2EF;">

    <ScrollPane fitToWidth="true"
                hbarPolicy="NEVER"
                VBox.vgrow="ALWAYS"
                style="-fx-background: transparent; -fx-background-color: transparent;">
        <content>
            <VBox spacing="18.0" style="-fx-padding: 18 24 24 24;">
                <VBox spacing="8.0"
                      style="-fx-background-color: #F5F7F6; -fx-border-color: #DDE5DF; -fx-border-width: 1; -fx-padding: 12 16 12 16;">
                    <Label text="Dashboard Des Offres"
                           style="-fx-text-fill: #0A2A3F; -fx-font-size: 42px; -fx-font-weight: bold;"/>
                </VBox>

                <VBox spacing="10.0"
                      style="-fx-background-color: linear-gradient(to right, #2F855A, #84CC16); -fx-background-radius: 20; -fx-padding: 24 24 24 24;">
                    <Label text="Bienvenue dans votre dashboard"
                           style="-fx-text-fill: #F6FFF8; -fx-font-size: 30px; -fx-font-weight: 300;"/>
                    <Label text="Gerez vos appels d'offre et vos reponses en quelques clics."
                           style="-fx-text-fill: #EAFFF1; -fx-font-size: 16px;"/>
                </VBox>

                <GridPane hgap="14.0" vgap="14.0">
                    <VBox spacing="14.0"
                          style="-fx-background-color: #F8FAF9; -fx-background-radius: 16; -fx-border-color: #DDE4DE; -fx-border-radius: 16; -fx-padding: 14 16 14 16;"
                          GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="Reponses totales" style="-fx-text-fill: #5E7A6A; -fx-font-size: 14px;"/>
                            <Pane HBox.hgrow="ALWAYS"/>
                        </HBox>
                        <Label text="6" style="-fx-text-fill: #1B6B4B; -fx-font-size: 42px; -fx-font-weight: bold;"/>
                    </VBox>

                    <VBox spacing="14.0"
                          style="-fx-background-color: #F8FAF9; -fx-background-radius: 16; -fx-border-color: #DDE4DE; -fx-border-radius: 16; -fx-padding: 14 16 14 16;"
                          GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="Validees" style="-fx-text-fill: #5E7A6A; -fx-font-size: 14px;"/>
                            <Pane HBox.hgrow="ALWAYS"/>
                        </HBox>
                        <Label text="4" style="-fx-text-fill: #1B6B4B; -fx-font-size: 42px; -fx-font-weight: bold;"/>
                    </VBox>

                    <VBox spacing="14.0"
                          style="-fx-background-color: #F8FAF9; -fx-background-radius: 16; -fx-border-color: #DDE4DE; -fx-border-radius: 16; -fx-padding: 14 16 14 16;"
                          GridPane.columnIndex="2" GridPane.rowIndex="0">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="En attente" style="-fx-text-fill: #5E7A6A; -fx-font-size: 14px;"/>
                            <Pane HBox.hgrow="ALWAYS"/>
                        </HBox>
                        <Label text="2" style="-fx-text-fill: #1B6B4B; -fx-font-size: 42px; -fx-font-weight: bold;"/>
                    </VBox>

                    <VBox spacing="14.0"
                          style="-fx-background-color: #F8FAF9; -fx-background-radius: 16; -fx-border-color: #DDE4DE; -fx-border-radius: 16; -fx-padding: 14 16 14 16;"
                          GridPane.columnIndex="3" GridPane.rowIndex="0">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="Eco points" style="-fx-text-fill: #5E7A6A; -fx-font-size: 14px;"/>
                            <Pane HBox.hgrow="ALWAYS"/>
                        </HBox>
                        <Label text="82690" style="-fx-text-fill: #1B6B4B; -fx-font-size: 42px; -fx-font-weight: bold;"/>
                    </VBox>
                </GridPane>

                <HBox spacing="14.0">
                    <VBox spacing="12.0"
                          style="-fx-background-color: #F8FAF9; -fx-background-radius: 16; -fx-border-color: #DDE4DE; -fx-border-radius: 16; -fx-padding: 18 18 18 18;"
                          HBox.hgrow="ALWAYS">
                        <Label text="Espace Valorisateur"
                               style="-fx-text-fill: #0D2B40; -fx-font-size: 22px; -fx-font-weight: bold;"/>
                        <Label text="Publiez un appel d'offre pour demander la collecte ou la valorisation."
                               style="-fx-text-fill: #5F7869; -fx-font-size: 14px;"/>
                        <Button mnemonicParsing="false"
                                onAction="#onOpenAppelOffre"
                                text="Ajouter un appel d'offre"
                                style="-fx-background-color: #84CC16; -fx-text-fill: #0D2B40; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 9 16 9 16;"/>
                    </VBox>

                    <VBox spacing="12.0"
                          style="-fx-background-color: #F8FAF9; -fx-background-radius: 16; -fx-border-color: #DDE4DE; -fx-border-radius: 16; -fx-padding: 18 18 18 18;"
                          HBox.hgrow="ALWAYS">
                        <Label text="Espace Citoyen"
                               style="-fx-text-fill: #0D2B40; -fx-font-size: 22px; -fx-font-weight: bold;"/>
                        <Label text="Proposez une reponse a un appel d'offre deja publie."
                               style="-fx-text-fill: #5F7869; -fx-font-size: 14px;"/>
                        <Button mnemonicParsing="false"
                                onAction="#onOpenReponseOffre"
                                text="Ajouter une reponse"
                                style="-fx-background-color: #84CC16; -fx-text-fill: #0D2B40; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 9 16 9 16;"/>
                    </VBox>
                </HBox>

                <VBox spacing="12.0"
                      style="-fx-background-color: #F8FAF9; -fx-background-radius: 16; -fx-border-color: #DDE4DE; -fx-border-radius: 16; -fx-padding: 18 18 18 18;">
                    <Label text="Dernieres reponses"
                           style="-fx-text-fill: #0D2B40; -fx-font-size: 24px; -fx-font-weight: 500;"/>
                    <Separator/>
                    <TableView prefHeight="230.0" style="-fx-background-radius: 10;">
                        <columns>
                            <TableColumn prefWidth="170.0" text="Date"/>
                            <TableColumn prefWidth="430.0" text="Offre"/>
                            <TableColumn prefWidth="200.0" text="Quantite"/>
                            <TableColumn prefWidth="200.0" text="Statut"/>
                        </columns>
                    </TableView>
                </VBox>
            </VBox>
        </content>
    </ScrollPane>

    <!-- Chatbot flottant -->
    <VBox fx:id="chatbaseWindow"
          managed="false"
          maxHeight="560.0" maxWidth="370.0"
          minHeight="560.0" minWidth="370.0"
          visible="false"
          style="-fx-background-color: #FFFFFF; -fx-background-radius: 14; -fx-border-color: #CDE3D6; -fx-border-radius: 14;">
        <HBox alignment="CENTER_LEFT" spacing="8.0"
              style="-fx-background-color: linear-gradient(to right, #2F7A56, #88CD2F); -fx-background-radius: 14 14 0 0; -fx-padding: 10 12 10 12;">
            <Label text="Assistant WasteWise" style="-fx-text-fill: #FFFFFF; -fx-font-size: 14px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button mnemonicParsing="false" onAction="#onCloseAssistant" text="x"
                    style="-fx-background-color: transparent; -fx-text-fill: #FFFFFF; -fx-font-size: 18px; -fx-font-weight: bold;"/>
        </HBox>
        <WebView fx:id="chatbaseWebView" prefHeight="520.0" prefWidth="370.0"/>
    </VBox>

</VBox>
